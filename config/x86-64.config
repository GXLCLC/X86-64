# ==============================================================================
# X86/64 固件编译配置种子文件（.config seed）
# ------------------------------------------------------------------------------
# 工作流会把本文件复制为 OpenWrt 源码根目录的 .config，然后执行 make defconfig。
# defconfig 会按照 Kconfig 依赖关系自动补全所有依赖包的默认选择，
# 因此这里只需要写：目标平台、镜像格式、以及你明确想要的插件/驱动。
#
# 自定义方法：
#   1. 直接在本文件增删 "CONFIG_PACKAGE_xxx=y" 行（=y 表示编入固件）；
#   2. 或者本地 make menuconfig 勾选后，把生成的 .config 内容替换到本文件；
#   3. 提交后在 GitHub Actions 页面手动触发编译即可。
# 注意：以 "# " 开头的配置项表示"不选择"；某些驱动若已内建于内核，
#       defconfig 会自动忽略对应选项，不影响编译。
# ==============================================================================

# ------------------------------------------------------------------------------
# 一、目标平台：只编译 X86/64（generic 子目标，覆盖绝大多数软路由/小主机）
# ------------------------------------------------------------------------------
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ------------------------------------------------------------------------------
# 二、镜像格式：只产出 IMG（.img.gz），不产出 VMDK/VDI/VHDX/ISO
# ------------------------------------------------------------------------------
# 使用 SquashFS 根文件系统：支持"恢复出厂设置"（重置 overlay），软路由推荐
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 镜像使用 gzip 压缩，输出 .img.gz（写盘工具可直接识别，也可解压后得到 .img）
CONFIG_TARGET_IMAGES_GZIP=y
# 同时生成传统 BIOS(GRUB) 引导与 EFI 引导两种 IMG（文件名分别带 combined / combined-efi）
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
# 以下虚拟机/光盘格式全部关闭，发布物只保留 IMG
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set
# CONFIG_ISO_IMAGES is not set
# rootfs 分区大小设为 2048MiB（=2GiB）：
# SquashFS 镜像中，分区减去只读根文件系统占用后，剩余空间全部作为 overlay，
# 即"可安装插件/存放配置"的可用空间，满足 overlay 预留 2G 的需求。
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ------------------------------------------------------------------------------
# 三、LuCI 基础界面
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
# LuCI 中文语言包（后台界面中文化）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# 旧版 Lua 接口兼容层：OFA 应用过滤、EasyTier 的 Lua 界面依赖它运行
CONFIG_PACKAGE_luci-compat=y

# ------------------------------------------------------------------------------
# 四、需求指定的常用插件
# 说明：只选 luci-app-* 界面包即可，其依赖的核心服务包（如 smartdns、
#       ddnsto、AdGuardHome、easytier、appfilter、kmod-oaf 等）会由
#       defconfig 自动选入，无需逐个手写。
# ------------------------------------------------------------------------------
# SmartDNS：高性能本地 DNS 转发/分流，多上游并发查询返回最快结果
CONFIG_PACKAGE_luci-app-smartdns=y
# DDNSTO：易有云提供的远程访问/内网穿透（通过 ddns.to 域名访问后台）
CONFIG_PACKAGE_luci-app-ddnsto=y
# AdGuardHome：全网广告/追踪域名拦截 DNS
CONFIG_PACKAGE_luci-app-adguardhome=y
# OFA 应用过滤（OpenAppFilter）：基于 DPI 的应用识别与过滤（家长控制/禁游戏视频等）
CONFIG_PACKAGE_luci-app-oaf=y
# Turbo ACC：网络加速（flow offloading 流量分载 + BBR 拥塞控制）
CONFIG_PACKAGE_luci-app-turboacc=y
# mwan3：多 WAN 负载均衡/策略分流（多线拨号、链路冗余）
CONFIG_PACKAGE_luci-app-mwan3=y
# 带宽监控：nlbwmon 流量统计，按设备/时间查看带宽用量
CONFIG_PACKAGE_luci-app-nlbwmon=y
# EasyTier：去中心化虚拟组网/内网穿透（带 Web 配置界面，支持点对网、网对网）
CONFIG_PACKAGE_luci-app-easytier=y
# Argon 主题（diy-part2 已将其设为默认主题）
CONFIG_PACKAGE_luci-theme-argon=y

# ------------------------------------------------------------------------------
# 五、常用系统工具
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_usbutils=y        # lsusb 等 USB 设备查看工具
CONFIG_PACKAGE_pciutils=y        # lspci 查看 PCI 设备（排查网卡识别）
CONFIG_PACKAGE_htop=y            # 进程/资源监控
CONFIG_PACKAGE_curl=y            # 命令行下载/调试
CONFIG_PACKAGE_ca-bundle=y       # CA 根证书（HTTPS 请求需要）
CONFIG_PACKAGE_block-mount=y     # 块设备挂载支持（挂载 USB 硬盘）

# ------------------------------------------------------------------------------
# 六、文件系统支持（配合 USB 存储使用）
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-fs-vfat=y    # FAT32
CONFIG_PACKAGE_kmod-fs-exfat=y   # exFAT（大容量 U 盘/TF 卡）
CONFIG_PACKAGE_kmod-fs-ntfs3=y   # NTFS 内核态读写（挂载 Windows 移动硬盘）

# ------------------------------------------------------------------------------
# 七、USB 驱动（USB 主控 / 存储 / 网卡 / 外设）
# ------------------------------------------------------------------------------
# USB 主控（X86 上部分已内建，显式选择保证不缺）
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
# USB 存储（U 盘/移动硬盘）
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y    # USB3 UAS 高速存储协议
# USB 有线网卡
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y  # CDC-Ether 标准 USB 网卡
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y    # CDC-NCM（多数 4G/5G 模组与网卡）
CONFIG_PACKAGE_kmod-usb-net-rndis=y      # RNDIS（手机 USB 共享网络）
CONFIG_PACKAGE_kmod-usb-net-asix=y       # ASIX 老款百兆/千兆 USB 网卡
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y  # ASIX AX88179 千兆 USB3 网卡
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y    # 瑞昱 RTL8152/8153 千兆 USB 网卡（内核版驱动）
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y  # 瑞昱官方版 8152/8156 驱动
CONFIG_PACKAGE_kmod-usb-net-aqc111=y     # Aquantia AQC111 5G/2.5G USB 网卡
# USB 外设
CONFIG_PACKAGE_kmod-usb-hid=y            # USB 键盘鼠标
CONFIG_PACKAGE_kmod-usb-audio=y          # USB 声卡

# ------------------------------------------------------------------------------
# 八、有线网卡驱动：Intel（英特尔）
# 说明：LEDE 的 x86 默认已包含大部分（i40e/iavf/igb/igc/e1000e 等），
#       这里显式声明一是保证不被裁剪，二是补上默认未含的 ixgbe 万兆驱动。
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-e1000=y      # 英特尔百兆/早期千兆（82540 等）
CONFIG_PACKAGE_kmod-e1000e=y     # 英特尔千兆（I219/I210/I350 等常见板载）
CONFIG_PACKAGE_kmod-igb=y        # 英特尔 I210/I211/I350 服务器/软路由常见
CONFIG_PACKAGE_kmod-igc=y        # 英特尔 I225/I226 2.5G 网卡
CONFIG_PACKAGE_kmod-ixgbe=y      # 英特尔 82599/X520/X540/X550 万兆
CONFIG_PACKAGE_kmod-i40e=y       # 英特尔 X710/XL710 万兆/四万兆
CONFIG_PACKAGE_kmod-iavf=y       # 英特尔 XL710 虚拟化功能驱动

# ------------------------------------------------------------------------------
# 九、有线网卡驱动：Realtek（瑞昱）
# 说明：r8168/r8125-rss/r8126-rss 为 LEDE x86 默认内置的瑞昱驱动，
#       显式声明确保保留；r8169 为内核通用驱动，一并保留作为兜底。
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-r8169=y      # 瑞昱 RTL8168/8169 千兆通用驱动
CONFIG_PACKAGE_kmod-r8168=y      # 瑞昱官方版千兆驱动
CONFIG_PACKAGE_kmod-r8125-rss=y  # 瑞昱 RTL8125 2.5G 网卡
CONFIG_PACKAGE_kmod-r8126-rss=y  # 瑞昱 RTL8126 5G 网卡

# ------------------------------------------------------------------------------
# 十、Intel 无线网卡（笔记本/迷你主机自带 WiFi 时使用）
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-iwlwifi=y    # 英特尔无线网卡驱动
CONFIG_PACKAGE_firmware-iwlwifi=y  # 英特尔无线网卡固件
