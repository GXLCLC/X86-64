# ======================================================================
#  OpenWrt(lede) X86_64 自定义配置（配置种子文件）
# ----------------------------------------------------------------------
#  这个文件怎么用：
#    1. 工作流会把本文件复制为 OpenWrt 源码目录下的 .config
#    2. 随后自动执行 make defconfig 补全所有依赖，不用手动补全
#    3. 想增加插件：直接加一行  CONFIG_PACKAGE_插件名=y
#    4. 想删除插件：删掉对应行，或把该行改成 "# CONFIG_... is not set"
#    5. 注意：CONFIG 行末尾不能写注释，注释必须单独成行(以 # 开头)
#    6. 重要：包名必须和源里完全一致(区分大小写和横线)。名字写错的话，
#       make defconfig 会把这行悄悄删掉，固件里就不会有这个插件！
#       (工作流加了"校验插件"步骤，丢了哪个会在日志里明确报出来)
#    7. 不确定插件名？可在 lede 仓库 package/ 目录、
#       kenzok8/openwrt-packages 仓库里搜索，或本地 make menuconfig 查看
# ======================================================================

# ==================== 一、目标平台：只编译 X86_64 ====================

# 选择 x86 平台
CONFIG_TARGET_x86=y

# 选择 64 位子平台
CONFIG_TARGET_x86_64=y

# 通用设备 profile（兼容所有 x86_64 主机和虚拟机）
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ==================== 二、镜像格式：只要 IMG ====================

# 输出 .img.gz 压缩镜像（下载后解压一次即得 .img，可直接写盘刷入）
CONFIG_TARGET_IMAGES_GZIP=y

# 生成 BIOS 传统启动的 combined 镜像（老主板用）
CONFIG_GRUB_IMAGES=y

# 生成 UEFI 启动的 combined 镜像（新主板/新虚拟机首选）
CONFIG_GRUB_EFI_IMAGES=y

# 明确关闭不需要的格式：
# ISO 是光盘镜像，QCOW2/VDI/VMDK/VHDX 是各种虚拟机专用磁盘格式，全部不要
# CONFIG_ISO_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set

# ==================== 三、分区大小：预留 2G 可写空间 ====================

# 内核/引导分区 64MB（比默认更宽裕，防止内核+模块放不下）
CONFIG_TARGET_KERNEL_PARTSIZE=64

# 根分区(含 overlay 可写空间)约 2GB，装完插件还能余出很多空间
CONFIG_TARGET_ROOTFS_PARTSIZE=2080

# ==================== 四、LuCI 网页管理界面 ====================
# ---------- 关键：统一 SSL/TLS 后端为 OpenSSL ----------
# OpenWrt 有三种 SSL 后端：openssl、mbedtls、wolfssl。
# luci-ssl 会自动选一个，但某些插件或默认依赖可能选了另一个，
# 导致 libustream-openssl 和 libustream-mbedtls 同时被编进来，
# 二者都提供 libustream-ssl.so 文件，package/install 阶段必炸！
# 显式统一选 OpenSSL（和 luci-ssl 保持一致，OpenSSL 最稳、证书兼容性最好）
CONFIG_PACKAGE_libustream-openssl=y
# 显式排除另外两个后端，防止 defconfig 自动选上
# CONFIG_PACKAGE_libustream-mbedtls is not set
# CONFIG_PACKAGE_libustream-wolfssl is not set
# libopenssl 和 libopenssl-conf 是 OpenSSL 后端的核心库
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-conf=y

# LuCI 主程序（网页管理后台）
CONFIG_PACKAGE_luci=y

# 让后台支持 HTTPS 访问（https://192.168.1.1）
# luci-ssl 会自动拉 libustream-openssl + libopenssl，
# 上面显式声明是为了确保不出现 mbedtls/wolfssl 变体
CONFIG_PACKAGE_luci-ssl=y

# 安装全套简体中文语言包（网页界面中文化）
CONFIG_LUCI_LANG_zh_Hans=y

# Argon 主题（lede 内置 luci 源提供，无需额外添加源）
# 注意：光装主题包不会自动启用它，默认主题切换在 files/etc/uci-defaults/zzz-custom-settings 里
CONFIG_PACKAGE_luci-theme-argon=y

# ==================== 五、核心网络加速插件 ====================

# Turbo ACC 网络加速（lede 内置 luci 源提供）
CONFIG_PACKAGE_luci-app-turboacc=y

# Turbo ACC 引擎选择：流量分载 offloading（x86 默认且最稳）
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y

# Turbo ACC 附加：启用 BBR 拥塞控制算法（改善高延迟/丢包网络的传输表现）
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y

# SmartDNS DNS 优化加速（lede 内置 luci 源）
CONFIG_PACKAGE_luci-app-smartdns=y

# AdGuardHome 全网去广告（lede 内置 luci 源提供管理界面，内核程序在 packages 源）
CONFIG_PACKAGE_luci-app-adguardhome=y

# ==================== 六、多拨/负载均衡 ====================

# mwan3 多 WAN 口负载均衡（lede 内置 luci 源）
# 支持多条宽带叠加带宽、故障自动切换
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y

# ==================== 七、带宽监控 ====================

# nlbwmon 网络带宽监控（lede 内置 luci 源）
# 可实时查看每个设备的流量、历史流量统计
CONFIG_PACKAGE_luci-app-nlbwmon=y

# ==================== 八、内网穿透/远程访问 ====================

# DDNSTO 内网穿透（来自 kenzok8 第三方源，工作流已自动添加该源）
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y

# EasyTier 去中心化组网（官方仓库：https://github.com/EasyTier/luci-app-easytier）
# 注意：EasyTier 不是标准 feeds 仓库，工作流会直接 git clone 到 package/ 目录
# 它提供 luci-app-easytier 管理界面 + easytier 主程序包
# 依赖 kmod-tun（下面内核驱动章节已启用）
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y

# ==================== 九、应用过滤 ====================

# OpenAppFilter 应用过滤（家长控制/应用管控）
# 来自独立仓库 https://github.com/destan19/OpenAppFilter，工作流自动 clone
# 包含三部分：luci-app-oaf 界面 + open-app-filter 工具 + oaf 内核模块
# 若上游更新导致编译失败，可注释掉下面这行后重新编译
CONFIG_PACKAGE_luci-app-oaf=y

# ==================== 十、其他常用小工具 ====================

# UPnP 自动端口映射（游戏联机/P2P 下载常用）
CONFIG_PACKAGE_luci-app-upnp=y

# 网络唤醒 WOL（远程开机家里电脑/ nas）
CONFIG_PACKAGE_luci-app-wol=y

# 网页终端 TTYD（浏览器里直接敲命令，不用装 SSH 工具）
CONFIG_PACKAGE_luci-app-ttyd=y

# ==================== 十一、内核模块和驱动 ====================
# 原理说明：
#   OpenWrt 的 kmod-* 包是内核驱动模块，固件需要它们才能识别硬件。
#   如果不把驱动编译进固件，刷机后网卡/USB 可能识别不出来。
#   下面按"主板芯片组类型"分类列出常用驱动，按需增减。

# ---------- TUN/TAP 虚拟网卡驱动 ----------
# EasyTier、WireGuard、OpenVPN 等 VPN 类应用都依赖 TUN
# x86_64 架构下一般内核已自带 TUN，但显式声明更安全
CONFIG_PACKAGE_kmod-tun=y

# ---------- Intel 网卡驱动 ----------
# e1000    = Intel 82540EM/82545EM/82546EB/82546GB 等千兆（老桌面/虚拟机常用）
CONFIG_PACKAGE_kmod-e1000=y

# e1000e   = Intel 82571/82572/82573/82574/82575/82576 等 PCIe 千兆（主流桌面/服务器）
CONFIG_PACKAGE_kmod-e1000e=y

# igb      = Intel I210/I211/I350/I354/I358 等 PCIe 千兆（新服务器/工控机）
CONFIG_PACKAGE_kmod-igb=y

# igc      = Intel I225/I226/I229/I239/I240 等 2.5G/千兆（11代酷睿起的主板网卡）
CONFIG_PACKAGE_kmod-igc=y

# ixgbe    = Intel 82598/82599/X520/X540/X550/X552 等万兆（10G 服务器网卡）
CONFIG_PACKAGE_kmod-ixgbe=y

# i40e     = Intel XL710/XL722/XXV710/XXV722 等 40G/25G（高速数据中心网卡，按需启用）
# CONFIG_PACKAGE_kmod-i40e is not set

# ---------- Realtek（瑞昱）网卡驱动 ----------
# r8169    = Realtek RTL8168/8169 PCIe 千兆（大部分普通主板的网卡）
# 注：OpenWrt 原生 r8169 驱动对部分 Realtek 2.5G 网卡支持有限，
#     如果你的主板是 2.5G 瑞昱（如 RTL8125BG/RTL8126），可能需要额外的 r8125/r8126 驱动包
CONFIG_PACKAGE_kmod-r8169=y

# ---------- Mellanox / Broadcom 等企业级网卡 ----------
# 家用/一般 x86_64 不需要，数据中心或特殊场景按需启用
# CONFIG_PACKAGE_kmod-mlx4_core is not set
# CONFIG_PACKAGE_kmod-tg3 is not set

# ---------- USB 主控驱动（识别 USB 接口本身）----------
# USB 2.0 主控（x86_64 几乎所有主板都有，必选）
CONFIG_PACKAGE_kmod-usb2=y

# USB 3.0 主控（有 USB 3.0/3.1/3.2 口的主板必选）
CONFIG_PACKAGE_kmod-usb3=y

# USB 通用核心（其他 kmod-usb-* 的依赖，自动选上，不用手动加）
# CONFIG_PACKAGE_kmod-usb-core is not set

# ---------- USB 存储驱动（U盘/移动硬盘）----------
# USB 大容量存储协议（绝大多数 U 盘/移动硬盘）
CONFIG_PACKAGE_kmod-usb-storage=y

# USB 大容量存储协议扩展（支持某些特殊 U 盘）
CONFIG_PACKAGE_kmod-usb-storage-extras=y

# ---------- USB 网卡驱动（USB 转 RJ45 网卡）----------
# RNDIS 协议的 USB 网卡（Android 手机 USB 共享上网也用这个）
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# CDC-Ethernet 协议的 USB 网卡（常见 USB 转 RJ45 适配器）
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y

# ASIX AX88179/AX88772 芯片的 USB 网卡（绿联等很多品牌用这个芯片）
CONFIG_PACKAGE_kmod-usb-net-asix=y

# Realtek RTL8150/RTL8152/RTL8153 芯片的 USB 网卡（瑞昱 USB 网卡）
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# ---------- 文件系统驱动（硬盘/U 盘格式支持）----------
# NTFS 文件系统支持：
# 现代内核（6.x+）的 NTFS3 驱动已内置进内核，无需单独 kmod。
# 但如果需要可靠的写入支持，用 FUSE 版 ntfs-3g 更稳（始终可用、不依赖内核版本）
# 注：旧的 kmod-fs-ntfs 在 lede master 上已不存在（内核 6.12 已弃用）
# ntfs-3g 会自动拉取 fuse 依赖，不用手动加 kmod-fuse（它在 x86_64 上也是内置的）
CONFIG_PACKAGE_ntfs-3g=y

# FAT32/exFAT 文件系统（读 U 盘/exFAT 格式移动硬盘）
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y

# ============ 十二、想加更多插件？ ============
# 复制下面的格式，把插件名换成你要的即可（记得去掉行首的 # ）：
#   CONFIG_PACKAGE_插件名=y
#
# 包名查找方法：
#   1. 本地编译时运行 make menuconfig，界面里能看到完整的 CONFIG 选项名
#   2. 在 GitHub 上搜：site:github.com/openwrt/luci "PKG_NAME:=luci-app-xxx"
#   3. 不确定就去 issues 里搜有没有人问过

# 常用可选插件示例（按需去掉注释启用）：
# CONFIG_PACKAGE_luci-app-samba4=y          # SMB 文件共享（局域网共享硬盘/U盘）
# CONFIG_PACKAGE_luci-app-hd-idle=y         # 硬盘休眠管理
# CONFIG_PACKAGE_luci-app-acl=y             # 访问控制列表（限制某些设备上网）
# CONFIG_PACKAGE_luci-app-arpbind=y         # IP/MAC 地址绑定（防 DHCP 欺骗）
# CONFIG_PACKAGE_luci-app-accesscontrol=y    # 上网时段控制（家长控制）
# CONFIG_PACKAGE_luci-app-diskman=y          # 磁盘管理（格式化、分区、挂载）
# CONFIG_PACKAGE_luci-app-cpufreq=y          # CPU 频率调节（省电/性能模式切换）
# CONFIG_PACKAGE_luci-app-vlmcsd=y          # KMS 激活服务器（Windows/Office 激活）
# CONFIG_PACKAGE_luci-app-zerotier=y        # ZeroTier 组网（EasyTier 的替代品）
# CONFIG_PACKAGE_luci-app-openclash=y       # Clash（代理插件，按要求本仓库不加）
