#!/bin/sh
# ==============================================================================
# 99-custom-settings —— 固件首次启动时自动执行的自定义初始化脚本
# ------------------------------------------------------------------------------
# 原理：OpenWrt 首次开机时会顺序执行 /etc/uci-defaults/ 下的脚本，
#       执行成功后自动删除，因此这里的设置只会生效一次，不影响后续使用。
# 作用：
#   1. 设置后台 root 登录密码（与 GitHub Release 发布说明中保持一致）
#   2. 固定 LAN 管理 IP 为 192.168.1.1
#   3. 设置 LuCI 默认语言为中文、默认主题为 Argon
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 设置 root 登录密码
#    busybox 自带 chpasswd 命令，格式 "用户名:密码"；
#    账号 root / 密码 password（刷机后请第一时间在后台修改）。
# ------------------------------------------------------------------------------
echo 'root:password' | chpasswd

# ------------------------------------------------------------------------------
# 2. 固定 LAN 口管理 IP
#    proto=static + ipaddr/netmask，保证发布说明中的登录地址始终有效；
#    若上层光猫网段冲突，可刷机后自行在「网络 - 接口」中修改。
# ------------------------------------------------------------------------------
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'

# ------------------------------------------------------------------------------
# 3. LuCI 默认语言与主题
#    - lang=zh_cn：后台默认中文
#    - theme=argon + mediaurlbase：新版 LuCI 通过这两项指定默认主题
# ------------------------------------------------------------------------------
uci set luci.main.lang='zh_cn'
uci set luci.main.theme='argon'
uci set luci.main.mediaurlbase='/luci-static/argon'

# 提交所有 UCI 修改并写入配置文件
uci commit

exit 0
